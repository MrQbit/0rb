# ── orb2 configuration ──────────────────────────────────────────────────
# Copy to `.env` (next to docker-compose.spark.yml) and fill in. `.env` is
# gitignored — never commit real secrets. `scripts/install.sh` creates this
# for you and generates ORB2_AUTH_SECRET automatically.

# ── Auth (email + one-time-code, allowlisted) ──
ORB2_API_AUTH_REQUIRED=1
# A long random secret that signs sessions + OTP codes. install.sh fills this.
ORB2_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
# Comma-separated emails allowed to sign in (the first is the owner).
ORB2_AUTH_ALLOWED_EMAILS=you@example.com
# Mark the session cookie Secure (use when serving over HTTPS / Tailscale).
ORB2_AUTH_COOKIE_SECURE=1

# ── Email delivery for OTP codes ──
# Zero-config default: codes are sent through the hosted Orb relay
# (orb2.app → Resend, fixed sign-in template only). Set your own SMTP below
# to send from your own account instead, or set ORB2_OTP_RELAY_URL="" to
# disable the relay entirely (codes then appear in the API log).
#ORB2_OTP_RELAY_URL=https://orb2.app/api/otp-send

# Optional: your own SMTP (Gmail: use an App Password) — takes precedence
ORB2_SMTP_HOST=smtp.gmail.com
ORB2_SMTP_PORT=465
ORB2_SMTP_USER=youragent@gmail.com
ORB2_SMTP_PASS=your_gmail_app_password
ORB2_SMTP_FROM=youragent@gmail.com

# ── Telegram channel (optional) — talk to the agent from Telegram ──
# Bot token from @BotFather; owner id is your numeric Telegram chat id.
ORB2_TELEGRAM_BOT_TOKEN=
ORB2_TELEGRAM_OWNER_ID=

# ── WhatsApp bridge (optional) — link your own WhatsApp via QR ──
# Comma-separated E.164 numbers allowed to text the agent (yours = self-chat).
ORB2_WHATSAPP_ALLOWED=
# Shared secret for the bridge→api webhook. install.sh generates one.
ORB2_WHATSAPP_BRIDGE_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Remote access: per-device HTTPS at <id>.device.orb2.app ──
# Zero-config remote URL with a real Let's Encrypt cert (DNS-01 via the
# hosted device relay; works behind NAT, no ports opened). Requires the
# enrollment secret from the Orb operator (baked into official installers).
#ORB2_DEVICE_DOMAIN=device.orb2.app
#ORB2_BROKER_URL=https://orb2.app
#ORB2_ENROLL_SECRET=
#ORB2_ACME_PRODUCTION=1

# ── Remote access via your own tailnet (scripts/setup-tailscale.sh) ──
# Your tailnet URL, e.g. https://spark.tailXXXXXX.ts.net
ORB2_PUBLIC_URL=

# ── Smart home (Home Assistant) — enables the Home tool + dashboard ──
# Orb drives a local Home Assistant instance (Matter/Zigbee/Z-Wave/WiFi).
# URL of your HA box + a long-lived access token (HA → profile → security).
# Can also be set from the first-run wizard (POST /v1/setup/home) or Settings.
ORB2_HA_URL=
ORB2_HA_TOKEN=

# ── Web search (SearXNG runs as a compose service; no key needed) ──
ORB2_SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-searxng-secret
# Optional: use Brave Search instead (free key from brave.com/search/api)
ORB2_BRAVE_API_KEY=

# ── Connected apps (or set from Settings → Apps) ──
# YouTube Data API v3 key (Google Cloud console) — search + play videos
ORB2_YOUTUBE_API_KEY=
# Spotify app (developer.spotify.com) — client credentials, search + play music
ORB2_SPOTIFY_CLIENT_ID=
ORB2_SPOTIFY_CLIENT_SECRET=
# NewsAPI key (newsapi.org) — search news / headlines
ORB2_NEWSAPI_KEY=
# Vercel — publish shareable pages to a public vercel.app URL (account token)
ORB2_VERCEL_TOKEN=
ORB2_VERCEL_TEAM_ID=

# ── Self-evolution (agent can build + sandbox-test + promote its own code) ──
# Requires the repo + docker socket mounted into orb2-api (compose does this).
ORB2_SELF_MODIFY_ENABLED=1
# Absolute host path of this repo (used for docker-in-docker bind mounts).
ORB2_SELF_SRC_HOST=/home/youruser/orb2

# ── Ports ──
ORB2_UI_PORT=9080
ORB2_UI_HTTPS_PORT=9443

# ── Hybrid brain (§17) — cloud reasoning, governed + budgeted in Settings ──
# Anthropic API key (preferred) or OpenRouter key; leave empty = 100% local.
ORB2_ANTHROPIC_KEY=

# ── Ring voice satellite (§16) — screenless voice via the Ring camera ──
# 1-year session token for the ringvoice bridge (mint via the api container).
ORB2_RINGVOICE_TOKEN=
# Speaker the orb answers through when the camera's own speaker isn't enabled.
ORB2_RING_FALLBACK_SPEAKER=living room
# Custom RTSP/stream overrides (normally autodiscovered over MQTT).
#ORB2_RING_RTSP=
#ORB2_RING_STREAM=

# ── Voice models ──
# STT model (hf-whisper engine, GPU): default openai/whisper-large-v3-turbo.
#ORB2_STT_MODEL=openai/whisper-large-v3-turbo
# Kokoro voice for Spanish replies (bilingual household support).
#ORB2_TTS_VOICE_ES=ef_dora
